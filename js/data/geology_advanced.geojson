    {
      "type": "Feature",
      "properties": {
        "id": "lower-galilee",
        "name_he": "הגליל התחתון",
        "name_en": "Lower Galilee (Folded Hills with Basalt Caps)",
        "rock_summary_he": "גיר ודולומיט מקופלים בפחות עוצמה מהגליל העליון, עם כתמי בזלת ניאוגנית מפוזרים",
        "description_he": "בניגוד לגליל העליון, הגליל התחתון נמוך יותר ומתאפיין בקפלים עדינים היוצרים סדרת רכסים ועמקים מקבילים (כמו הר תבור, רכס יודפת). כתמי בזלת קדומים (כיסוי בזלתי מהניאוגן) פזורים על פני האזור ומעידים על פעילות געשית מוקדמת יותר מזו של הגולן. השילוב של קרקע בזלתית פורייה עם קרקע טרשית יוצר פסיפס נופי מגוון שהיסטורית אפשר גם חקלאות וגם רעייה.",
        "color": "#A9B36B",
